# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API). Used from Phase 2 onwards.
#
# Variables must start with VITE_ so Vite exposes them to the browser.
# The anon key is designed to be public. Your data is protected by
# Row Level Security (RLS) rules in the database, not by hiding this key.
# NEVER put the "service_role" key in this file or anywhere in frontend code.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
